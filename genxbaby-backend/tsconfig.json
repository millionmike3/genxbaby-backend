{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    "outDir": "./dist"
  },

  "include": [
    "backend/src/**/*.ts"
  ],

  "exclude": ["node_modules", "dist"]
}
