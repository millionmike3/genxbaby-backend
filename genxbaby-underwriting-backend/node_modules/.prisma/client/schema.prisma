generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// Core Admin + Audit
//
model Admin {
  id            String     @id
  email         String     @unique
  passwordHash  String
  role          String     @default("ADMIN")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  walletAddress String?
  AuditLog      AuditLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  createdAt DateTime @default(now())
  adminId   String
  ip        String?
  metadata  Json?
  Admin     Admin    @relation(fields: [adminId], references: [id])
}

//
// Owners, Roles, Permissions
//
model Owner {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  createdAt DateTime @default(now())

  properties   Property[]
  roles        Role[]
  users        User[]
  bankProfiles BankProfile[]
}

model Role {
  id             String           @id
  ownerId        String
  name           String
  createdAt      DateTime         @default(now())
  Owner          Owner            @relation(fields: [ownerId], references: [id])
  RolePermission RolePermission[]
  UserRole       UserRole[]
}

model Permission {
  id             String           @id
  key            String           @unique
  name           String
  RolePermission RolePermission[]
}

model RolePermission {
  id           String     @id
  roleId       String
  permissionId String
  Permission   Permission @relation(fields: [permissionId], references: [id])
  Role         Role       @relation(fields: [roleId], references: [id])
}

model User {
  id        String     @id
  ownerId   String
  email     String     @unique
  name      String?
  password  String
  createdAt DateTime   @default(now())
  Owner     Owner      @relation(fields: [ownerId], references: [id])
  UserRole  UserRole[]
}

model UserRole {
  id     String @id
  userId String
  roleId String
  Role   Role   @relation(fields: [roleId], references: [id])
  User   User   @relation(fields: [userId], references: [id])
}

//
// Banking + Checks
//
model BankProfile {
  id              String   @id
  ownerId         String
  bankName        String
  routingNumber   String
  accountNumber   String
  accountType     String
  signerName      String?
  signatureImage  String?
  nextCheckNumber Int      @default(1)
  createdAt       DateTime @default(now())
  Owner           Owner    @relation(fields: [ownerId], references: [id])
  Check           Check[]
  Signer          Signer[]
}

model Check {
  id            String      @id
  checkNumber   Int
  payee         String
  amount        Float
  memo          String?
  date          DateTime
  bankProfileId String
  signerId      String
  createdAt     DateTime    @default(now())
  BankProfile   BankProfile @relation(fields: [bankProfileId], references: [id])
  Signer        Signer      @relation(fields: [signerId], references: [id])
}

model Signer {
  id             String      @id
  bankProfileId  String
  name           String
  title          String?
  signatureImage String?
  createdAt      DateTime    @default(now())
  BankProfile    BankProfile @relation(fields: [bankProfileId], references: [id])
  Check          Check[]
}

//
// Underwriting Engine
//
model Borrower {
  id                   Int      @id @default(autoincrement())
  firstName            String
  lastName             String
  email                String   @unique
  annualIncome         Float?
  creditScore          Int?
  behaviorScore        Float?
  financialHealthScore Float?
  createdAt            DateTime @default(now())

  mortgages         Mortgage[]
  underwritingCases UnderwritingCase[]
  applications      Application[]
}

model Application {
  id         String   @id @default(uuid())
  borrowerId Int
  borrower   Borrower @relation(fields: [borrowerId], references: [id])

  amount         Int
  purpose        String
  propertyValue  Int?
  incomeAmount   Int?
  incomeYears    Int?
  incomeVerified Boolean?

  ltv Float?
  dti Float?

  decisionStatus String?
  decisionTier   String?
  decisionRate   Float?
  decisionNotes  String?

  polygonTxHash String?
  anchoredAt    DateTime?
  merkleRoot    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    Document[]
  underwriting Underwriting?
}

model Document {
  id            String  @id @default(uuid())
  applicationId String
  name          String
  verified      Boolean @default(false)

  Application Application @relation(fields: [applicationId], references: [id])
}

model Underwriting {
  id            String    @id @default(uuid())
  applicationId String    @unique
  riskScore     Float?
  fraudSignals  Json?
  decision      String?
  pricingModel  Json?
  decidedAt     DateTime?

  Application Application @relation(fields: [applicationId], references: [id])
}

model Property {
  id                  Int      @id @default(autoincrement())
  ownerId             String?
  address             String
  city                String
  state               String
  zipcode             String
  propertyType        String?
  squareFeet          Int?
  bedrooms            Int?
  bathrooms           Float?
  marketValue         Float?
  valuationConfidence Float?
  capRate             Float?
  noi                 Float?
  dscr                Float?
  sanitizerPass       Boolean  @default(false)
  sanitizerReason     String?
  createdAt           DateTime @default(now())

  owner     Owner?     @relation(fields: [ownerId], references: [id])
  mortgages Mortgage[]
}

model Mortgage {
  id           Int      @id @default(autoincrement())
  borrowerId   Int
  propertyId   Int
  loanAmount   Float
  interestRate Float?
  termMonths   Int?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  borrower Borrower @relation(fields: [borrowerId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  // Expose relation only — no fields/references here
  underwritingCase UnderwritingCase?
}

model UnderwritingCase {
  id              Int       @id @default(autoincrement())
  borrowerId      Int
  mortgageId      Int       @unique
  riskScore       Float?
  collateralScore Float?
  fraudScore      Float?
  financialScore  Float?
  behaviorScore   Float?
  decision        String    @default("PENDING")
  pricingJson     String?
  merkleRoot      String?
  anchoredTxHash  String?
  anchoredBlock   Int?
  anchoredAt      DateTime?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  borrower Borrower @relation(fields: [borrowerId], references: [id])
  mortgage Mortgage @relation(fields: [mortgageId], references: [id])
}

//
// Anchoring + Notifications
//
model AnchorBatch {
  id          String         @id @default(cuid())
  merkleRoot  String
  txHash      String
  blockNumber Int
  anchoredAt  DateTime       @default(now())
  anchors     AnchorRecord[]
  createdAt   DateTime       @default(now())
}

model AnchorRecord {
  id            String       @id @default(cuid())
  applicationId String
  merkleRoot    String
  txHash        String
  blockNumber   Int
  anchoredAt    DateTime     @default(now())
  batchId       String?
  batch         AnchorBatch? @relation(fields: [batchId], references: [id])
  riskScore     Int?
  createdAt     DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  createdAt DateTime @default(now())
}
