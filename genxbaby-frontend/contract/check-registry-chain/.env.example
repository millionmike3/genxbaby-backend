###############################################
#  CheckRegistry – Environment Configuration  #
###############################################

# ---------------------------------------------
# ACTION to perform with scripts/check-registry.js
# Options:
#   deploy   → deploy + verify contract
#   roles    → grant REGISTER_ROLE + VOID_ROLE
#   batch    → run batch registration
# ---------------------------------------------
ACTION=deploy
# ACTION=roles
# ACTION=batch


###############################################
# Contract Deployment / Verification
###############################################

# Set after deployment (auto-printed by script)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000


###############################################
# Role Setup (only used when ACTION=roles)
###############################################

# Wallet allowed to register checks
REGISTER_ADMIN=0x0000000000000000000000000000000000000000

# Wallet allowed to void checks
VOID_ADMIN=0x0000000000000000000000000000000000000000


###############################################
# Network Configuration
###############################################

# Polygon Amoy RPC (example)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# Your private key (DO NOT commit real key)
PRIVATE_KEY=your_private_key_here


###############################################
# Optional Future Fields (IPFS, metadata, etc.)
###############################################

# IPFS API key (if you add QR codes / seals)
IPFS_API_KEY=

# IPFS secret
IPFS_API_SECRET=
