generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Owner {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  users        User[]
  roles        Role[]
  bankProfiles BankProfile[]
}

model User {
  id        String   @id @default(cuid())
  ownerId   String
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  owner Owner      @relation(fields: [ownerId], references: [id])
  roles UserRole[]

  behaviorSessions BehaviorSession[]
  behaviorProfiles BehaviorProfile[]
}

model Role {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())

  owner       Owner            @relation(fields: [ownerId], references: [id])
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id   String @id @default(cuid())
  key  String @unique
  name String

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
}

model BankProfile {
  id              String   @id @default(cuid())
  ownerId         String
  bankName        String
  routingNumber   String
  accountNumber   String
  accountType     String
  signerName      String?
  signatureImage  String?
  nextCheckNumber Int      @default(1)
  createdAt       DateTime @default(now())

  owner   Owner    @relation(fields: [ownerId], references: [id])
  signers Signer[]
  checks  Check[]
}

model Signer {
  id             String   @id @default(cuid())
  bankProfileId  String
  name           String
  title          String?
  signatureImage String?
  createdAt      DateTime @default(now())

  bankProfile BankProfile @relation(fields: [bankProfileId], references: [id])
  checks      Check[]
}

model Check {
  id            String   @id @default(cuid())
  checkNumber   Int
  payee         String
  amount        Float
  memo          String?
  date          DateTime
  bankProfileId String
  signerId      String
  createdAt     DateTime @default(now())
  reissuedToId  String?

  bankProfile BankProfile                @relation(fields: [bankProfileId], references: [id])
  signer      Signer                     @relation(fields: [signerId], references: [id])
  fraudFlags  FraudFlag[]
  sarReports  SuspiciousActivityReport[]
}

model FraudFlag {
  id        String   @id @default(cuid())
  type      String
  severity  String
  message   String
  checkId   String
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)

  check      Check                      @relation(fields: [checkId], references: [id])
  sarReports SuspiciousActivityReport[]
}

model SuspiciousActivityReport {
  id        String   @id @default(cuid())
  flagId    String
  checkId   String
  severity  String
  type      String
  summary   String
  createdAt DateTime @default(now())

  check Check     @relation(fields: [checkId], references: [id])
  flag  FraudFlag @relation(fields: [flagId], references: [id])
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("ADMIN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  walletAddress String?

  auditLogs AuditLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  createdAt DateTime @default(now())
  adminId   String
  ip        String?
  metadata  Json?

  admin Admin @relation(fields: [adminId], references: [id])
}

model AuditAnchor {
  id        Int      @id @default(autoincrement())
  root      String
  count     Int
  createdAt DateTime @default(now())
}

model BehaviorSession {
  id                  String   @id @default(cuid())
  userId              String?
  leadId              String?
  investorId          String?
  pillar              Pillar
  page                String
  startedAt           DateTime @default(now())
  endedAt             DateTime
  clickCount          Int
  clickRate           Float
  burstIndex          Int
  rageClickScore      Float
  formFillTimeMs      Int
  abandonedFormsCount Int
  avgTimeOnPageMs     Int
  sessionVolatility   Float
  impulsivenessScore  Float
  createdAt           DateTime @default(now())

  investor Investor? @relation(fields: [investorId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
}

model BehaviorProfile {
  id                    String   @id @default(cuid())
  userId                String?
  leadId                String?
  investorId            String?
  pillar                Pillar
  sessionsCount         Int      @default(0)
  avgImpulsivenessScore Float    @default(0)
  maxImpulsivenessScore Float    @default(0)
  impulsivenessLevel    String
  updatedAt             DateTime @default(now())

  investor Investor? @relation(fields: [investorId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
}

model Lead {
  id    String @id @default(uuid())
  email String @unique

  behaviorProfiles BehaviorProfile[]
  behaviorSessions BehaviorSession[]
}

model Investor {
  id    String  @id @default(uuid())
  email String  @unique
  name  String?

  behaviorProfiles BehaviorProfile[]
  behaviorSessions BehaviorSession[]
}

enum Pillar {
  STOCK_SANITIZER
  CUSTOMER
  INVESTOR
}

model RiskHistoryLog {
  id        String   @id @default(cuid())
  ownerId   String
  timestamp DateTime @default(now())

  fraudScore      Int
  sarSeverity     Int
  volatilityIndex Int
  behaviorScore   Int
  bankRiskScore   Int

  riskScore    Int
  riskTier     String
  finalRateBps Int

  @@index([ownerId])
}

model PricingDecisionLog {
  id        String   @id @default(cuid())
  ownerId   String
  timestamp DateTime @default(now())

  baseRateBps  Int
  marginBps    Int
  finalRateBps Int

  riskScore Int
  riskTier  String

  fraudScore      Int
  sarSeverity     Int
  volatilityIndex Int
  behaviorScore   Int
  bankRiskScore   Int

  @@index([ownerId])
}

model OwnerDocument {
  id        String   @id @default(cuid())
  ownerId   String
  fileName  String
  filePath  String
  mimeType  String
  status    String
  createdAt DateTime @default(now())

  ocrExtractions OCRExtraction[]
  fraudResults   DocumentFraudResult[]

  @@index([ownerId])
}

model OCRExtraction {
  id        String   @id @default(cuid())
  docId     String
  text      String
  createdAt DateTime @default(now())

  document OwnerDocument @relation(fields: [docId], references: [id])
}

model DocumentFraudResult {
  id         String   @id @default(cuid())
  docId      String
  fraudScore Int
  issues     String[]
  createdAt  DateTime @default(now())

  document OwnerDocument @relation(fields: [docId], references: [id])
}

model IncomeVerificationSnapshot {
  id        String   @id @default(cuid())
  ownerId   String
  timestamp DateTime @default(now())

  sourceType         String
  grossMonthlyIncome Int
  netMonthlyIncome   Int
  incomeStability    Int
  employerMatch      Int
  bankMatch          Int

  incomeVerificationScore Int

  @@index([ownerId])
}

model TimelineEvent {
  id            String   @id @default(uuid())
  applicationId String
  borrowerId    String
  eventType     String
  payload       Json
  createdAt     DateTime @default(now())
}
